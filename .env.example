VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Local preview only. Do not enable this in production.
VITE_DEMO_MODE=false

# Used by scripts/sync-html.mjs in a private content repo or trusted CI.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_OWNER_USER_ID=00000000-0000-0000-0000-000000000000
# Optional for scripts/supabase-live-init.mjs. If SUPABASE_OWNER_USER_ID is
# omitted, the script can resolve or create a manual Auth user from this email.
SUPABASE_OWNER_EMAIL=owner@example.com
SUPABASE_OWNER_PASSWORD=replace-with-a-strong-password
SUPABASE_CREATE_OWNER_IF_MISSING=false
# Used by npm run test:live. Defaults to SUPABASE_OWNER_EMAIL/PASSWORD if omitted.
LIVE_TEST_EMAIL=reader@example.com
LIVE_TEST_PASSWORD=reader-password
# Used by npm run test:live:isolation. Must be a different manually-created Auth user.
LIVE_SECOND_EMAIL=reader-b@example.com
LIVE_SECOND_PASSWORD=reader-b-password
# Required by scripts/supabase-live-init.mjs when it applies the SQL migration.
# Either provide SUPABASE_DB_URL or SUPABASE_PROJECT_REF + SUPABASE_DB_PASSWORD.
# SUPABASE_DB_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
HTML_SYNC_SOURCE_DIR=html
HTML_SYNC_BUCKET=html-docs

# Used by Supabase Edge Functions.
AI_PROVIDER=openai-compatible
AI_PROFILE_LABEL=Default Model
AI_MODEL=your-model-name
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-provider-api-key

# Optional multi-model config for Edge Functions.
# AI_PROFILES_JSON=[{"id":"default","label":"Default","provider":"openai-compatible","model":"your-model","enabled":true,"baseUrl":"https://api.openai.com/v1","apiKeyEnv":"AI_API_KEY"}]
# Example for multiple OpenAI-compatible providers. Set the matching secrets manually:
# supabase secrets set OPENAI_API_KEY="..." DEEPSEEK_API_KEY="..."
# AI_PROFILES_JSON=[{"id":"openai","label":"OpenAI GPT","provider":"openai-compatible","model":"gpt-4o-mini","enabled":true,"baseUrl":"https://api.openai.com/v1","apiKeyEnv":"OPENAI_API_KEY"},{"id":"deepseek","label":"DeepSeek Chat","provider":"openai-compatible","model":"deepseek-chat","enabled":true,"baseUrl":"https://api.deepseek.com/v1","apiKeyEnv":"DEEPSEEK_API_KEY"}]

# GitHub Actions secrets for .github/workflows/deploy-supabase.yml.
# Do not put these in frontend runtime builds.
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password
